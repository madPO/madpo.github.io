---
import BaseLayout from "./BaseLayout.astro";

const { title, description } = Astro.props.frontmatter;
---
<link rel="preload" href="/fonts/MartianMonoVF.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
<style is:global>
  @reference "tailwindcss";

  .note-layout {
    @apply text-base py-6 px-4 text-[#E5E6E5] w-screen lg:w-[75vw] mx-auto;
  }

  p {
    @apply my-2;
  }

  h1 {
    @apply text-5xl font-bold my-4;
  }

  h2 {
    @apply text-4xl font-bold my-3 border-b-2 border-zinc-200 pb-1;
  }

  a {
    @apply underline;
    text-decoration-color: #F6C90E;
  }

  a:hover {
    @apply underline text-[#F6C90E];
  }

  .astro-code {
    @apply p-7;
  }

  ul {
    @apply px-7;
  }

  li {
    @apply list-disc m-2;
  }
</style>
<BaseLayout title={title} description={description}>
  <main class="note-layout">
    <slot />
  </main>
</BaseLayout>
