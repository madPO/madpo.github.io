---
import BaseLayout from "./BaseLayout.astro";

const { title, description, tags, canonical } = Astro.props;
const currentYear = new Date().getFullYear();
---

<link
    rel="preload"
    href="/fonts/MartianMonoVF.woff2"
    as="font"
    type="font/woff2"
    crossorigin="anonymous"
/>
<style is:global lang="postcss">
    @font-face {
        font-family: Martian Mono;
        font-display: swap;
        src: url("/fonts/MartianMonoVF.woff2") format("woff2");
        font-weight: 100 800;
        font-stretch: 75% 112.5%;
    }

    .note-layout {
        font-size: 1rem;
        padding-top: 1.5rem;
        padding-bottom: 1.5rem;
        padding-left: 1rem;
        padding-right: 1rem;
        color: oklch(0.9239 0.0017 145.56);
        width: 100vw;
        max-width: 75vw;
        margin-left: auto;
        margin-right: auto;

        @media (min-width: 300px) and (max-width: 1024px) {
            max-width: 100vw;
            margin-left: 0;
            margin-right: 0;
        }

        p {
            margin-top: 0.5rem;
            margin-bottom: 0.5rem;
        }

        h1 {
            font-size: 3rem;
            font-weight: bold;
            margin-top: 1rem;
            margin-bottom: 1rem;
        }

        h2 {
            font-size: 2.25rem;
            font-weight: bold;
            margin-top: 0.75rem;
            margin-bottom: 0.75rem;
            border-width: 0;
            border-bottom-width: 2px;
            border-bottom-color: oklch(0.869 0.0198 252.89);
            padding-bottom: 0.25rem;
            border-style: solid;
        }

        a {
            text-decoration: underline;
            text-decoration-color: oklch(0.8506 0.1723 92.22);
            color: oklch(0.9239 0.0017 145.56);

            &:hover {
                text-decoration: underline;
                color: oklch(0.8506 0.1723 92.22);
            }
        }

        .astro-code {
            padding: 1.75rem;
            font-family: Martian Mono, monospace;
        }

        ul {
            padding-left: 1.75rem;
        }

        li {
            list-style-type: disc;
            margin: 0.5rem;
        }
    }
</style>
<BaseLayout title={title} description={description} tags={tags} canonical={"notes/" + canonical}>
    <div class="note-layout">
        <slot />
    </div>
</BaseLayout>
