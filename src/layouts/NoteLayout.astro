---
import BaseLayout from "./BaseLayout.astro";

const { title, description, tags } = Astro.props.frontmatter;
const currentYear = new Date().getFullYear();
---

<link
    rel="preload"
    href="/fonts/MartianMonoVF.woff2"
    as="font"
    type="font/woff2"
    crossorigin="anonymous"
/>
<style is:global lang="postcss">
    @font-face {
        font-family: Martian Mono;
        font-display: swap;
        src: url("/fonts/MartianMonoVF.woff2") format("woff2");
        font-weight: 100 800;
        font-stretch: 75% 112.5%;
    }

    .note-layout {
        font-size: 1rem;
        padding-top: 1.5rem;
        padding-bottom: 1.5rem;
        padding-left: 1rem;
        padding-right: 1rem;
        color: oklch(0.9239 0.0017 145.56);
        width: 100vw;
        max-width: 75vw;
        margin-left: auto;
        margin-right: auto;

        p {
            margin-top: 0.5rem;
            margin-bottom: 0.5rem;
        }

        h1 {
            font-size: 3rem;
            font-weight: bold;
            margin-top: 1rem;
            margin-bottom: 1rem;
        }

        h2 {
            font-size: 2.25rem;
            font-weight: bold;
            margin-top: 0.75rem;
            margin-bottom: 0.75rem;
            border-width: 0;
            border-bottom-width: 2px;
            border-bottom-color: oklch(0.869 0.0198 252.89);
            padding-bottom: 0.25rem;
            border-style: solid;
        }

        a {
            text-decoration: underline;
            text-decoration-color: oklch(0.8506 0.1723 92.22);
            color: oklch(0.9239 0.0017 145.56);

            &:hover {
                text-decoration: underline;
                color: oklch(0.8506 0.1723 92.22);
            }
        }

        .astro-code {
            padding: 1.75rem;
            font-family: Martian Mono, monospace;
        }

        ul {
            padding-left: 1.75rem;
        }

        li {
            list-style-type: disc;
            margin: 0.5rem;
        }
    }

    .note-foooter {
        border-top: 2px solid oklch(0.7 0.0017 145.56);
        padding-top: 1rem;
        margin-top: 2rem;
        text-align: center;
        color: oklch(0.7 0.0017 145.56);
        font-size: 0.8rem;

        li, ul, p {
            list-style: none;
            display: inline-block;
        }

        a {
            text-decoration: underline;
            text-decoration-color: oklch(0.8506 0.1723 92.22);
            color: oklch(0.9239 0.0017 145.56);
            margin: 0 0.5rem;

            &:hover {
                text-decoration: underline;
                color: oklch(0.8506 0.1723 92.22);
            }
        }
    }
</style>
<BaseLayout title={title} description={description} tags={tags}>
    <main class="note-layout">
        <slot />
    </main>
    <footer class="note-foooter">
        <ul>
            <li><a href="/">About</a></li>
            <li><a href="/notes">Notes</a></li>
        </ul>
        <p>©{currentYear} Семён Зорькин</p>
    </footer>
</BaseLayout>
