---
const { title, description, tags, canonical } = Astro.props;
const sitePath = Astro.site;
---

<html lang="ru">
    <head>
        <meta charset="utf-8" />
        <meta
            name="google-site-verification"
            content="XwPI3A2kNsc3W806tr8dbYcjctebwq-Y7vd_JY_jFc4"
        />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="generator" content={Astro.generator} />
        <meta name="author" content="Семён Зорькин" />
        <meta
            name="description"
            content={description
                ? description
                : "Персональная страница Семёна Зорькина. Разработчик, инженер, автор."}
        />
        <meta name="robots" content="index, follow" />
        <meta
            name="keywords"
            content={"Семён Зорькин, разработчик, инженер, projects," + tags}
        />
        <link rel="sitemap" href="/sitemap-index.xml" />
        <link
            rel="preload"
            href="/fonts/MartianGrotesk-VFVF.woff2"
            as="font"
            type="font/woff2"
            crossorigin="anonymous"
        />
        <link
            rel="icon"
            type="image/png"
            href="icons/favicon-96x96.png"
            sizes="96x96"
        />
        <link rel="icon" type="image/svg+xml" href="icons/favicon.svg" />
        <link rel="shortcut icon" href="icons/favicon.ico" />
        <link
            rel="apple-touch-icon"
            sizes="180x180"
            href="icons/apple-touch-icon.png"
        />
        <meta name="apple-mobile-web-app-title" content="madpo.me" />
        <link rel="manifest" href="site.webmanifest" />
        <link rel="canonical" href={sitePath + canonical} />
        <title>{title} | {sitePath}</title>
        <style is:global lang="postcss">
            @import-sanitize;

            @font-face {
                font-family: Martian Grotesk;
                font-display: swap;
                src: url("/fonts/MartianGrotesk-VFVF.woff2") format("woff2");
                font-weight: 100 1000; /* Th: 100, xLt: 200, Lt: 300, Rg: 400, Md: 500, (no 600), Bd: 700, xBd: 800, Bl: 900, Ult: 1000 */
                font-stretch: 75% 200%; /* Cn: 75%,  Nr: 87.5%,  Std: 100%,  sWd: 112.5%,  Wd: 125%,  xWd: 150%,  uWd: 200% */
            }

            :root {
                font-family: Martian Grotesk, ui-serif, Georgia, Cambria, 'Times New Roman', Times, serif;
            }
        </style>
    </head>

    <body class="body-container">
        <main class="main-container">
            <slot />
        </main>
        <footer class="footer-container">
            <ul>
                <li><a href="/contact">Контакты</a></li>
                <li><a href="/notes">Заметки</a></li>
            </ul>
            <p>
                ©{new Date().getFullYear()} Семён Зорькин. Контент: <a
                    href="https://creativecommons.org/licenses/by-nc/4.0/"
                    rel="license noopener"
                    target="_blank">CC BY‑NC 4.0.</a
                >
            </p>
        </footer>
    </body>
</html>

<style lang="postcss">
    .body-container {
        background-color: oklch(0.0672 0 0);
        display: flex;
        flex-direction: column;
        min-height: 100vh;
    }

    .main-container {
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    .footer-container {
        border-top: 2px solid oklch(0.7 0.0017 145.56);
        padding-top: 1rem;
        margin-top: 2rem;
        text-align: center;
        color: oklch(0.7 0.0017 145.56);
        font-size: 0.8rem;
        height: auto;

        li, ul, p {
            padding: 0;
            list-style: none;
            display: inline-block;
        }

        a {
            text-decoration: underline;
            text-decoration-color: oklch(0.8506 0.1723 92.22);
            color: oklch(0.9239 0.0017 145.56);
            margin: 0 0.5rem;

            &:hover {
                text-decoration: underline;
                color: oklch(0.8506 0.1723 92.22);
            }
        }
    }
</style>
