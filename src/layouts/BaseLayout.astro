---
import "../app/global.css";
const { title } = Astro.props;
---

<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | madpo.me</title>
  </head>
  <body class="bg-[#070C08]">
    <slot />
  </body>
</html>
