---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Picture } from "astro:assets";
import avatar from "../../public/avatars/avatar.png";
---

<BaseLayout title="Семён Зорькин" canonical="">
    <div class="image-text-container">
        <Picture
            class="avatar-image"
            src={avatar}
            alt="Зорькин Семён"
            formats={["webp", "png", "jpeg"]}
            fetchpriority="high"
            loading="eager"
            width={356}
            height={520}
            layout="constrained"
            decoding="async"
            role="img"
            aria-label="Портрет Семён Зорькин"
        />
        <div class="text-container">
            <h1 class="name-text">Семён Зорькин</h1>
        </div>
    </div>
</BaseLayout>

<style lang="postcss">
    .image-text-container {
      align-self: center;
      margin-top: 15%;
      display: flex;
      gap: 0.5rem;
      flex-direction: column;

      @media (min-width: 1024px) {
        flex-direction: row;
      }

      .text-container {
        display: flex;
        align-items: center;
        padding-left: 0.5rem;

        .name-text {
          color: white;
          font-size: 2rem;
          font-weight: bold;
        }
      }
    }
</style>
