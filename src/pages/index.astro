---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Picture } from "astro:assets";
import avatar from "../../public/avatars/avatar.png";
---

<BaseLayout title="Семён Зорькин">
  <main class="min-h-screen flex items-center justify-center p-6 lg:p-0">
    <div
      class="flex gap-2 flex-col lg:flex-row"
    >
      <Picture
        class="border-10 border-gray-200"
        widths={[540]}
        sizes={`(max-width: 600px) 540px`}
        src={avatar}
        alt="Зорькин Семён"
        formats={["webp", "png", "jpeg"]}
        height={540}
        fetchpriority="high"
      />
      <div class="flex items-center px-2">
        <h1 class="text-white text-4xl font-bold">Семён Зорькин</h1>
      </div>
    </div>
  </main>
</BaseLayout>
