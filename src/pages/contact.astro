---
import BaseLayout from "../layouts/BaseLayout.astro";

const emailAction = btoa('mailto:job@madpo.me');
---

<BaseLayout title="Контакты" canonical="contact">
    <div class="main-container">
        <ul>
            <li>
                <svg
                    class="icon"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    width="16"
                    height="16"
                    role="img"
                    aria-label="Email icon"
                >
                    <path
                        d="M20 4H4C2.9 4 2 4.9 2 6v12c0 1.1 0.9 2 2 2h16c1.1 0 2-0.9 2-2V6c0-1.1-0.9-2-2-2zm0 2-8 5-8-5h16zm-8 7L4 8v10h16V8l-8 5z"
                    ></path>
                </svg>
                <a href={"javascript:window.location.href=atob('"+emailAction+"')"} aria-label="Написать на job@madpo.me">Написать мне</a>
            </li>
            <li>
                <svg
                    class="icon"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 96 96"
                    fill="currentColor"
                    width="16"
                    height="16"
                    role="img"
                    aria-label="GitHub icon"
                >
                    <path
                        d="M48.854 0C21.839 0 0 22 0 49.217c0 21.756 13.993 40.172 33.405 46.69 2.427.49 3.316-1.059 3.316-2.362 0-1.141-.08-5.052-.08-9.127-13.59 2.934-16.42-5.867-16.42-5.867-2.184-5.704-5.42-7.17-5.42-7.17-4.448-3.015.324-3.015.324-3.015 4.934.326 7.523 5.052 7.523 5.052 4.367 7.496 11.404 5.378 14.235 4.074.404-3.178 1.699-5.378 3.074-6.6-10.839-1.141-22.243-5.378-22.243-24.283 0-5.378 1.94-9.778 5.014-13.2-.485-1.222-2.184-6.275.486-13.038 0 0 4.125-1.304 13.426 5.052a46.97 46.97 0 0 1 12.214-1.63c4.125 0 8.33.571 12.213 1.63 9.302-6.356 13.427-5.052 13.427-5.052 2.67 6.763.97 11.816.485 13.038 3.155 3.422 5.015 7.822 5.015 13.2 0 18.905-11.404 23.06-22.324 24.283 1.78 1.548 3.316 4.481 3.316 9.126 0 6.6-.08 11.897-.08 13.526 0 1.304.89 2.853 3.316 2.364 19.412-6.52 33.405-24.935 33.405-46.691C97.707 22 75.788 0 48.854 0z"
                    ></path></svg
                >
                GitHub: <a href="https://github.com/madpo" target="_blank"
                    >madpo</a
                >
            </li>
            <li>
                <svg
                    class="icon"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    width="16"
                    height="16"
                    role="img"
                    aria-label="LinkedIn icon"
                >
                    <path
                        d="M19 0h-14c-2.76 0-5 2.24-5 5v14c0 2.76 2.24 5 5 5h14c2.76 0 5-2.24 5-5v-14c0-2.76-2.24-5-5-5zm-11 19h-3v-10h3v10zm-1.5-11.25c-.97 0-1.75-.78-1.75-1.75s.78-1.75 1.75-1.75 1.75.78 1.75 1.75-.78 1.75-1.75 1.75zm13.5 11.25h-3v-5.6c0-1.34-.03-3.07-1.87-3.07-1.87 0-2.13 1.46-2.13 2.97v5.7h-3v-10h2.88v1.37h.04c.4-.75 1.38-1.54 2.84-1.54 3.04 0 3.6 2 3.6 4.59v5.58z"
                    ></path>
                </svg>
                LinkedIn: <a
                    href="https://linkedin.com/in/madpo"
                    target="_blank">Zorkin S.A.</a
                >
            </li>
        </ul>
    </div>
</BaseLayout>

<style lang="postcss">
  .main-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    margin-top:25%;
    padding: 1.5rem;

    h1 {
      font-size: 2rem;
      font-weight: bold;
      margin-bottom: 1rem;
    }

    ul {
      list-style: none;
      padding: 0;

      li {
        margin: 0.5rem 0;
        color: oklch(0.7 0.0017 145.56);
        display: flex;
        align-items: center;

        .icon {
          margin-right: 0.5rem;
          fill: oklch(0.7 0.0017 145.56);
        }

        a {
          text-decoration: underline;
          color: oklch(0.9239 0.0017 145.56);

          &:hover {
            color: oklch(0.8506 0.1723 92.22);
          }
        }
      }
    }
  }
</style>
